{
  "name": "@zigpoll/openclaw-plugin",
  "version": "0.1.0",
  "description": "Zigpoll surveys, feedback, and response analytics for OpenClaw agents",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JasonZigelbaum/openclaw-zigpoll"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "zigpoll",
    "surveys",
    "feedback",
    "analytics"
  ],
  "files": [
    "index.ts",
    "src",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "typebox": "1.1.39"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.24-beta.2"
  },
  "openclaw": {
    "extensions": ["./index.ts"],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.3.24-beta.2"
    }
  }
}
